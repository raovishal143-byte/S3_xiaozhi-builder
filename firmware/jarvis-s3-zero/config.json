{
  "type": "jarvis-s3-zero",
  "target": "esp32s3",
  "builds": [
    {
      "name": "jarvis-s3-zero",
      "sdkconfig_append": [
        "CONFIG_SPIRAM=y",
        "CONFIG_SPIRAM_MODE_QUAD=y",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\""
      ]
    }
  ],
  "led_behavior": {
    "startup": {"onboard": "red", "blinks": 5},
    "standby": {"onboard": "off", "external": "solid_on"},
    "listening": {"onboard": "blue_blink"},
    "processing": {"onboard": "blue_blink"},
    "speaking": {"onboard": "green_blink", "external": "green_blink", "synchronized": true}
  }
}
