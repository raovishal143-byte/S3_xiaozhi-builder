{
  "type": "jarvis-s3-zero",
  "target": "esp32s3",
  "builds": [
    {
      "name": "jarvis-s3-zero",
      "sdkconfig_append": [
        "CONFIG_SPIRAM=y",
        "CONFIG_SPIRAM_MODE_QUAD=y",
        "CONFIG_SPIRAM_SPEED_80M=y",
        "CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y",
        "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v2/4m.csv\""
      ]
    }
  ]
}
